<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="true">
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.lhstack.tools</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>JTools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="lhstack@foxmail.com" url="https://github.com/lhstack">lhstack</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    <div>
        <span> <a href="https://github.com/lhstack/JTools">Help</a></span>
    </div>
    <h1>JTools</h1>
    <p>JTools is a plugin management container that simplifies the development process for IntelliJ IDEA plugins. It supports plugin lifecycle management and hot-plugging without affecting IDEA.</p>
    <h1>Main Features</h1>
    <p>1. Plugin panel with draggable installation and right-click uninstall options.</p>
    <p>2. Plugin development module for rapid debugging, supporting Java, Kotlin, and JavaScript.</p>
    <p>3. Native support for Java and JavaScript plugins.</p>
    <p>4. Customizable plugin installation directory.</p>
    <p>5. Integrated logging module for troubleshooting during plugin development and runtime.</p>
    <p>6. Java plugin development supports dynamic SDK dependencies installation, including IDEA, Maven, and Gradle projects.</p>
    <p>7. JS plugin allows flexible integration of web pages, with options for custom development.</p>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>org.intellij.groovy</depends>
    <depends>org.jetbrains.plugins.gradle.dependency.updater</depends>

    <projectListeners>
        <listener class="com.lhstack.tools.listener.PluginProjectManagerListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </projectListeners>
    <applicationListeners>
        <listener class="com.lhstack.tools.listener.PluginAppLifecycleListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.lhstack.tools.ToolsMainWindowFactory" id="JTools"
                    secondary="true" anchor="right"/>
        <toolWindow factoryClass="com.lhstack.tools.JLoggerWindowFactory" id="Run"
                    secondary="true" anchor="bottom"/>
        <postStartupActivity implementation="com.lhstack.tools.listener.ProjectStartupActivity"/>
        <notificationGroup displayType="BALLOON" id="JToolsNotification" toolWindowId="TODO"/>
    </extensions>
</idea-plugin>