<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="true">
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.lhstack.tools</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>JTools</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="lhstack@foxmail.com" url="https://github.com/lhstack">lhstack</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
    <div>
        <span> <a href="https://github.com/lhstack/JTools">Help</a></span>
    </div>
    <h1>JTools</h1>
    <p>JTools是一个集成管理,开发,运行的插件管理容器,它可以简化idea的插件开发流程,有完整的插件生命周期,支持插件热插拔,而不影响idea</p>
    <h1>主要功能</h1>
    <p>1. 它有插件面板,可拖动,点击安装插件,可右键卸载插件</p>
    <p>2. 它有插件开发模块,可方便开发者在这个容器上快速调试插件,支持Js,Java,Kotlin方式开发插件</p>
    <p>3. 它支持原生java插件和js插件</p>
    <p>4. 它可以手动配置插件的安装目录</p>
    <p>5. 它内部集成集成了日志模块,以便于插件运行和开发的过程中通过日志排查问题</p>
    <p>6. Java插件开发支持动态安装Sdk依赖,不限于idea,maven,gradle项目</p>
    <p>7. Js插件支持配置的方式集成公网页面,也可以自己开发页面,非常灵活</p>
  ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>org.jetbrains.idea.maven</depends>
    <depends>org.intellij.groovy</depends>
    <depends>org.jetbrains.plugins.gradle.dependency.updater</depends>

    <projectListeners>
        <listener class="com.lhstack.tools.listener.PluginProjectManagerListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </projectListeners>
    <applicationListeners>
        <listener class="com.lhstack.tools.listener.PluginAppLifecycleListener"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.lhstack.tools.ToolsMainWindowFactory" id="JTools"
                    secondary="true" anchor="right"/>
        <postStartupActivity implementation="com.lhstack.tools.listener.ProjectStartupActivity"/>
        <notificationGroup displayType="BALLOON" id="JToolsNotification" toolWindowId="TODO"/>
    </extensions>
</idea-plugin>